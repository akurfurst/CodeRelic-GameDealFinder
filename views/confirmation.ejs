<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="images/icon.png">
    <link rel="stylesheet" href="/styles/submit-deal.css">
    <title>Deal Submmitted</title>
</head>
<body>
    <%- include('../views/navbar')%>
    <div id="confirmation">
        <h1>Deal Submitted!</h1>
        <p>Title: <%= deal.title %></p>
        <p>Price: <%= deal.price %></p>
        <p>Free: <%= deal.original_price %></p>
        <p>URL: <%= deal.deal_url %></p>
        <p>Experation Date: <%= deal.expiry_date %></p>
        <p>Platform: <%= deal.platform %></p>
    </div>
</body>
</html>