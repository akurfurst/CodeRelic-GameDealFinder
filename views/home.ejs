<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="images/icon.png">
    <link rel="stylesheet" href="/styles/styles.css">
    <script src="/js/script.js" defer></script>
    <title>Game Deal Finder</title>
</head>
<body>
    <header>
        <h1>Game Deal Finder</h1>
        <label for="search">Search
            <input type="search" id="search" name="search">
        </label>
    </header>
    <nav>
        <div id="account" class="nav">
            <a href="#">Account</a>
        </div>
        <div id="settings" class="nav">
            <a href="#">Settings</a>
        </div>
        <div id="about-us" class="nav">
            <a href="/about-us">About Us</a>
        </div>
        <div id="add-deal" class="nav">
            <a href="#">Add Deal</a>
        </div>
    </nav>
    <div id="filter">
        <fieldset id="platform" class="filters">
            <legend>Filter</legend>
            <h3>Platform</h3>
            <label for="steam">
                <input type="checkbox" id="steam" name="platform[]" value="steam">Steam
            </label>
            <label for="xbox">
                <input type="checkbox" id="xbox" name="platform[]" value="xbox">Xbox
            </label>
            <label for="playstation">
                <input type="checkbox" id="playstation" name="platform[]" value="playstation">Playstation
            </label>
            <label for="epic">
                <input type="checkbox" id="epic" name="platform[]" value="epic">Epic
            </label>
            <label for="nintendo">
                <input type="checkbox" id="nintendo" name="platform[]" value="nintendo">Nintendo
            </label>
            <h3>Price</h3>
            <label for="under20">
                <input type="checkbox" id="under20" name="price[]" value="under20">Under $20
            </label>
            <label for="under15">
                <input type="checkbox" id="under15" name="price[]" value="under15">Under $15
            </label>
            <label for="under10">
                <input type="checkbox" id="under10" name="price[]" value="under10">Under $10
            </label>
            <label for="under5">
                <input type="checkbox" id="under5" name="price[]" value="under5">Under $5
            </label>
        </fieldset>
    </div>
    <div id="main">
        <% deals.forEach(deal=> { %>
            <div class="deal-card">
                <h2><%= deal.title %></h2>
                <p>price: $<%= deal.price %></p>
                <p>Discount: -<%= deal.discount %>%</p>
                <p>Platform: <%= deal.platform %></p>
                <p>Duration: <%= deals.duration %> days</p>
            </div>
        <% }) %>
    </div>
</body>
</html>