    <div id="filter">
        <fieldset id="platform" class="filters">
            <legend>Filter</legend>
            <h2>Platform</h2>
            <label for="steam">
                <input type="checkbox" id="steam" name="platform[]" value="steam">Steam
            </label>
            <label for="xbox">
                <input type="checkbox" id="xbox" name="platform[]" value="xbox">Xbox
            </label>
            <label for="playstation">
                <input type="checkbox" id="playstation" name="platform[]" value="playstation">Playstation
            </label>
            <label for="epic">
                <input type="checkbox" id="epic" name="platform[]" value="epic">Epic
            </label>
            <label for="nintendo">
                <input type="checkbox" id="nintendo" name="platform[]" value="nintendo">Nintendo
            </label>
            <h2>Price</h2>
            <label for="under20">
                <input type="checkbox" id="under20" name="price[]" value="under20">Under $20
            </label>
            <label for="under15">
                <input type="checkbox" id="under15" name="price[]" value="under15">Under $15
            </label>
            <label for="under10">
                <input type="checkbox" id="under10" name="price[]" value="under10">Under $10
            </label>
            <label for="under5">
                <input type="checkbox" id="under5" name="price[]" value="under5">Under $5
            </label>
        </fieldset>
    </div>
    <div id="main">
        <% deals.forEach(deal=> { %>
            <div class="deal-card">
                <h3><%= deal.title %></h3>
                <p>price: </p><p>$<%= deal.price %></p>
                <p>Discount: </p><p>-<%= deal.discount %>%</p>
                <p>Platform: </p><p><%= deal.platform %></p>
                <p>Duration: </p><p><%= deals.duration %> days</p>
            </div>
        <% }) %>
    </div>
</body>
</html>